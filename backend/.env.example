# Copy to .env and adjust.
#
# Local dev default is SQLite (zero setup). To use Neon Postgres in deployment,
# set DATABASE_URL to your Neon connection string, e.g.:
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/dbname?sslmode=require
#
# SQLAlchemy swaps drivers on this single variable — no code change needed.
DATABASE_URL=sqlite:///./kawayan.db

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000

# Feature flag: the structural calculator stays OFF until an engineer (SME)
# has reviewed the numeric rules. See PLAN.md sections 3E/3F and 7.
CALCULATOR_ENABLED=false
